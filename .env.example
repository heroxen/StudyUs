# ============================================================================
# ENVIRONMENT VARIABLES FOR STUDYUS
# ============================================================================
# 
# Copy this file to .env and fill in the values below.
# Do NOT commit .env to version control. Only commit .env.example.
#
# ============================================================================

# ============================================================================
# EXPO APP CONFIGURATION
# ============================================================================
#
# EXPO_PUBLIC_DOMAIN
# Description: The Replit dev or production domain used for cloud backup.
#              The mobile app uses this to construct the API endpoint.
# Example: abc.replit.dev (Replit automatically sets this in their environment)
# Required: Yes, for cloud backup functionality
#
EXPO_PUBLIC_DOMAIN=your-replit-domain.replit.dev

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================
#
# SESSION_SECRET
# Description: Secret key for Express session encryption.
#              Used by the API server to sign and verify session cookies.
# Value: Should be a long random string (32+ characters)
# Example: "your-super-secret-key-at-least-32-characters-long"
# Required: Yes, for API server
# Security: Keep this secret and rotate periodically in production
#
SESSION_SECRET=your-super-secret-key-at-least-32-characters-long

# ============================================================================
# OPTIONAL: DATABASE CONFIGURATION (FUTURE USE)
# ============================================================================
#
# Uncomment and configure these when PostgreSQL integration is needed.
#
# DATABASE_URL=postgresql://user:password@localhost:5432/studyus_dev
# NODE_ENV=development

# ============================================================================
# END OF ENVIRONMENT VARIABLES
# ============================================================================
